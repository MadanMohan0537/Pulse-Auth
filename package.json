{
  "name": "pulse-auth",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone OAuth2/OIDC authentication service for the Pulse platform — Cloudflare Workers, D1, Durable Objects.",
  "scripts": {
    "dev": "wrangler dev --port 4545 --ip 0.0.0.0",
    "start": "wrangler dev --port 4545 --ip 0.0.0.0",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply pulse-auth --local",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.13.3",
    "jose": "^6.2.10",
    "otpauth": "^9.5.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260823.1",
    "typescript": "^5.5.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  },
  "type": "module"
}
